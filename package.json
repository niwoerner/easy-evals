{
	"name": "easy-evals",
	"version": "0.0.1",
	"description": "An intentionally easy way of running evals against coding agents.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.11",
		"@types/node": "24.10.1",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	}
}
